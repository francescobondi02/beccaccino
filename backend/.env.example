# Backend configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Local dev: a plain postgres URL is fine.
# PRODUCTION (Neon): use the POOLED URL (host contains "-pooler") and append
#   ?connection_limit=5&pool_timeout=10
# so Prisma respects Neon's pooler limits and fails fast on starvation.
# Example:
#   postgresql://USER:PASS@ep-xxxx-pooler.neon.tech/becca?sslmode=require&connection_limit=5&pool_timeout=10
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/becca

# REQUIRED, even locally. Direct (non-pooled) URL used by `prisma migrate deploy`.
# Prisma fails schema validation if this is unset — it does NOT fall back to
# DATABASE_URL. Locally just mirror DATABASE_URL; on Neon use the non-pooled host
# (no "-pooler" in the hostname).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/becca

PORT=8000
JWT_SECRET=generate-a-random-64-char-hex-string
NODE_ENV=development

# Optional: lower for faster E2E tests (default: 41)
# GAME_WIN_POINTS=12

# Turn timeout (seconds). Auto-plays for idle players.
TURN_TIMEOUT_SECONDS=60
BRISCOLA_TIMEOUT_SECONDS=90

# Practice games vs AI bots. Both values are required to create a practice
# room. The tier-specific readiness check wakes a sleeping service and returns
# 503 without creating a room when that model or shared credential is unavailable.
# Point this at the Python inference service:
#   cd ai && BOT_SERVICE_TOKEN=local-secret uvicorn serving.app:app --port 8011
# BOT_SERVICE_URL=http://localhost:8011
# BOT_SERVICE_TOKEN=local-secret

# Pause before a bot plays, so consecutive bot turns are watchable rather than
# resolving instantly. Default 1000.
# BOT_THINK_DELAY_MS=1000

# Logging: pino level. Default: info (debug for verbose, warn/error for quiet).
# LOG_LEVEL=info
