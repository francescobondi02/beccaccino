generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Non-pooled URL, required by Neon for `migrate deploy`. Prisma validates that
  // every env() here RESOLVES, so an unset DIRECT_URL fails the whole schema —
  // it does not silently fall back. Local envs therefore set it to the same
  // value as DATABASE_URL (see .env.example); only Neon needs them to differ.
  directUrl = env("DIRECT_URL")
}

enum Suit {
  denara
  coppe
  spade
  bastoni
}

enum Value {
  asso
  due
  tre
  quattro
  cinque
  sei
  sette
  fante
  cavallo
  re
}

// ===========
// User
// ===========
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String?   @unique          // Email opzionale per OAuth
  password  String?                    // Password opzionale (null per OAuth)
  isBot     Boolean   @default(false)  // Bot account: excluded from leaderboard/stats

  // OAuth fields
  googleId  String?   @unique          // Google OAuth ID

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
  deletedAt DateTime?                  // Set when the account is anonymized (soft delete)

  players   Player[]
}

// ===========
// Player
// ===========
model Player {
  id         Int      @id @default(autoincrement())
  seat       Int?                       // 0–3 (serve per ordine nei round)
  isReady    Boolean   @default(false)
  team       Int?                 // 0 o 1
  botModel   String?              // Difficulty tier driving this seat; null = human
  timeoutCount Int     @default(0)
  abandonedAt DateTime?

  userId     Int
  gameRoomId Int

  user          User      @relation(fields: [userId], references: [id])
  gameRoom      GameRoom  @relation(fields: [gameRoomId], references: [id])
  playedCards   PlayedCard[]
  handCards     HandCard[]
  calledRounds  Round[]
  startedTricks Trick[]   @relation("startedTricks")
  wonTricks     Trick[]   @relation("wonTricks")
  @@unique([gameRoomId, seat])
  @@unique([gameRoomId, userId])
  @@index([userId])
  @@index([gameRoomId])
}

// ===========
// GameRoom
// ===========
model GameRoom {
  id             Int       @id @default(autoincrement())
  code           String    @unique  // tipo "ABCD"
  started        Boolean   @default(false)
  finished       Boolean   @default(false)
  winnerTeam     Int?      // 0 or 1; null while playing or when the game ended with no winner
  isPractice     Boolean   @default(false)  // Human vs bots: excluded from all aggregates
  botTier        String?   // Fill empty multiplayer seats at startup; null = humans only
  pausedAt       DateTime?
  pauseEpoch     Int       @default(0)
  version        Int       @default(0)  // Grows by one with every game state change
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())

  players   Player[]
  rounds    Round[]
}

// ===========
// Round
// ===========
model Round {
  id          Int       @id @default(autoincrement())
  number      Int                 // 1, 2, 3, ...
  callerId    Int                 // Chooses the briscola and leads trick 1
  briscola    Suit?               // fissata a inizio round
  briscolaAutoChosen Boolean @default(false) // true = the server chose after a timeout or bot failure
  cricca      Boolean   @default(false) // true se il caller ha Tre+Due+Asso di briscola
  gameRoomId  Int
  winnerTeam  Int?                // 0 or 1; null until the round ends
  team0Raw    Int       @default(0) // Points in thirds: real points = raw / 3, figures = raw % 3
  team1Raw    Int       @default(0)
  createdAt   DateTime  @default(now())

  caller      Player    @relation(fields: [callerId], references: [id])
  gameRoom    GameRoom  @relation(fields: [gameRoomId], references: [id])
  tricks      Trick[]
  handCards   HandCard[]
  @@unique([gameRoomId, number])
}

// ===========
// Trick
// ===========
model Trick {
  id          Int       @id @default(autoincrement())
  number      Int               // 1–10
  roundId     Int
  starterId   Int
  winnerId    Int?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  round       Round     @relation(fields: [roundId], references: [id])
  starter     Player    @relation("startedTricks", fields: [starterId], references: [id])
  winner      Player?   @relation("wonTricks", fields: [winnerId], references: [id], onDelete: Restrict)
  cards       PlayedCard[]
  @@unique([roundId, number])
}

// ===========
// PlayedCard
// ===========
model PlayedCard {
  id       Int     @id @default(autoincrement())
  trickId  Int
  playerId Int
  suit     Suit       // "coppe", "denara", ...
  value    Value      // "asso", "due", "re", etc.
  position Int       // ordine di gioco: 0–3
  signal   String?    // "striscio" | "busso" | "volo" | null
  // true when the server chose the card instead of the seat owner: a human
  // timeout or a bot service failure. Excluded from training data.
  autoPlayed Boolean @default(false)

  trick    Trick  @relation(fields: [trickId], references: [id])
  player   Player @relation(fields: [playerId], references: [id])
  @@unique([trickId, position])
  @@index([playerId])
}

// ===========
// HandCard
// ===========
// A card a player still holds in the current round. Playing it deletes the row.
model HandCard {
  id         Int    @id @default(autoincrement())
  playerId   Int
  roundId    Int
  suit       Suit
  value      Value

  player     Player @relation(fields: [playerId], references: [id])
  round      Round  @relation(fields: [roundId], references: [id])
  @@index([playerId])
  @@index([roundId])
}
