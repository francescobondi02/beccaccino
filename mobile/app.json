{
  "expo": {
    "name": "BECCA Dev",
    "slug": "becca-mobile",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "scheme": "becca-dev",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101014",
    "ios": {
      "bundleIdentifier": "com.beccaccino.mobile.dev",
      "supportsTablet": false
    },
    "android": {
      "package": "com.beccaccino.mobile.dev"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101014",
          "image": "./assets/icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
