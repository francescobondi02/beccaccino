{
  "name": "becca-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "dependencies": {
    "@expo/log-box": "~58.0.12",
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.16",
    "expo-audio": "58.0.9",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-haptics": "58.0.7",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.5",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --lan",
    "start:dev-client": "expo start --dev-client --lan",
    "android": "expo start --go --lan --android",
    "ios": "expo start --go --lan --ios",
    "build:android": "expo run:android",
    "build:ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "expo-doctor",
    "export": "expo export --platform all",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand",
    "check:sdk": "expo install --check"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ]
  },
  "private": true
}
