    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "migrate": "npx prisma migrate deploy",
