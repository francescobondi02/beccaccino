generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Non-pooled URL, required by Neon for `migrate deploy`. Prisma validates that
  // every env() here RESOLVES, so an unset DIRECT_URL fails the whole schema —
  // it does not silently fall back. Local envs therefore set it to the same
  // value as DATABASE_URL (see .env.example); only Neon needs them to differ.
  directUrl = env("DIRECT_URL")
}

enum Suit {
  denara
  coppe
  spade
  bastoni
}

enum Value {
  asso
  due
  tre
  quattro
  cinque
  sei
  sette
  fante
  cavallo
  re
}

// ===========
// User
// ===========
model User {
  id                      Int       @id @default(autoincrement())
  username                String    @unique
  email                   String?   @unique          // Email opzionale per OAuth
  password                String?                    // Password opzionale (null per OAuth)
  isBot                   Boolean   @default(false)  // Bot account: excluded from leaderboard/stats
  expertAccessGrantedAt   DateTime?

  // OAuth fields
  googleId  String?  @unique          // Google OAuth ID

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
  deletedAt DateTime?                // Set when the account is anonymized (soft delete)

  players             Player[]
  expertAnnotations   ExpertAnnotation[]
}

// =================
// Expert annotation
// =================
model AnnotationScenario {
  id                  Int      @id @default(autoincrement())
  code                String   @unique
  decisionType        String   @default("play_card")
  predictedDifficulty String
  importance          Int
  tags                String[]
  state               Json
  stateHash           String   @unique
  sourceBatch         String
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  annotations ExpertAnnotation[]

  @@index([active, predictedDifficulty])
}

model ExpertAnnotation {
  id                  Int      @id @default(autoincrement())
  userId              Int
  scenarioId          Int
  scenarioHash        String
  selectedSuit        Suit?
  selectedValue       Value?
  selectedSignal      String?
  selectedBriscola    Suit?
  skipped             Boolean  @default(false)
  comment             String?
  perceivedDifficulty String
  responseTimeMs      Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt @default(now())

  user     User               @relation(fields: [userId], references: [id])
  scenario AnnotationScenario @relation(fields: [scenarioId], references: [id])

  @@unique([userId, scenarioId])
  @@index([scenarioId])
}

// ==============
// PracticeMatch
// ==============
// A finished or abandoned practice game, snapshotted just before its live rows
// are deleted (see services/practiceArchive.ts). One row per game: the whole
// match lives in `payload`, so nothing here needs the game tables to survive.
model PracticeMatch {
  id            Int      @id @default(autoincrement())
  humanSeat     Int
  botTier       String   // Difficulty the three bots played at
  completed     Boolean  // false = abandoned before a team reached the win score
  schemaVersion Int      // Payload and replay rules, so old games stay readable
  payload       Json
  startedAt     DateTime
  endedAt       DateTime // Last move in the game, not the archive time
}

// ===========
// Player
// ===========
model Player {
  id         Int      @id @default(autoincrement())
  seat       Int?                       // 0–3 (serve per ordine nei round)
  isReady    Boolean   @default(false)
  team       Int?                 // 0 o 1
  botModel   String?              // Difficulty tier driving this seat; null = human
  timeoutCount Int     @default(0)
  abandonedAt DateTime?

  userId     Int
  gameRoomId Int

  user       User      @relation(fields: [userId], references: [id])
  gameRoom   GameRoom  @relation(fields: [gameRoomId], references: [id])
  playedCards PlayedCard[]
  playerCards PlayerCard[]
  @@unique([gameRoomId, seat])
  @@unique([gameRoomId, userId])
  @@index([userId])
  @@index([gameRoomId])
}

// ===========
// GameRoom
// ===========
model GameRoom {
  id             Int       @id @default(autoincrement())
  code           String    @unique  // tipo "ABCD"
  started        Boolean   @default(false)
  finished       Boolean   @default(false)
  isPractice     Boolean   @default(false)  // Human vs bots: excluded from all aggregates
  botTier        String?   // Fill empty multiplayer seats at startup; null = humans only
  pausedAt       DateTime?
  pauseEpoch     Int       @default(0)
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())

  players   Player[]
  rounds    Round[]
}

// ===========
// Hand
// ===========
model Hand {
  id         Int       @id @default(autoincrement())
  number     Int               // 1–10
  roundId    Int
  starterId  Int               // playerId che ha iniziato la mano
  winnerId   Int?              // playerId che ha preso
  createdAt  DateTime  @default(now())

  round      Round     @relation(fields: [roundId], references: [id])
  cards      PlayedCard[]
  @@unique([roundId, number])
}

// ===========
// Round
// ===========
model Round {
  id          Int       @id @default(autoincrement())
  number      Int                 // 1, 2, 3, ...
  briscola    Suit?               // fissata a inizio round
  // null = scelta precedente al tracciamento; true = scelta dal server
  briscolaAutoChosen Boolean?
  cricca      Boolean   @default(false) // true se il caller ha Tre+Due+Asso di briscola
  gameRoomId  Int
  winnerTeam  Int?                // 0 o 1 (oppure nullable finché non finisce)
  team0Points Int       @default(0) // Punti team 0
  team1Points Int       @default(0) // Punti team 1
  team0Figures Int      @default(0) // Figure team 0 (1/3 di punto)
  team1Figures Int      @default(0) // Figure team 1 (1/3 di punto)
  createdAt   DateTime  @default(now())

  gameRoom    GameRoom  @relation(fields: [gameRoomId], references: [id])
  hands       Hand[]
  playerCards PlayerCard[]
  @@unique([gameRoomId, number])
}

// ===========
// PlayedCard
// ===========
model PlayedCard {
  id       Int     @id @default(autoincrement())
  handId   Int
  playerId Int
  suit     Suit       // "coppe", "denara", ...
  value    Value      // "asso", "due", "re", etc.
  position Int       // ordine di gioco: 0–3
  signal   String?    // "striscio" | "busso" | "volo" | null
  // true quando la carta è stata scelta dal server, non dal proprietario del
  // posto: timeout di un umano, oppure fallback quando il bot service fallisce.
  // Serve per escludere queste mosse dai dati di training.
  // null = giocata precedente al tracciamento
  autoPlayed Boolean?

  hand     Hand   @relation(fields: [handId], references: [id])
  player   Player @relation(fields: [playerId], references: [id])
  @@unique([handId, position])
  @@index([playerId])
}

// ===========
// PlayerCard
// ===========
model PlayerCard {
  id         Int    @id @default(autoincrement())
  playerId   Int
  roundId    Int
  suit       Suit
  value      Value
  inHand     Boolean @default(true) // true finché non giocata

  player     Player @relation(fields: [playerId], references: [id])
  round      Round  @relation(fields: [roundId], references: [id])
  @@index([playerId])
  @@index([roundId])
}
