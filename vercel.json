{
  "git": { "deploymentEnabled": false },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://beccaccino-server.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://beccaccino-server.onrender.com/socket.io/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
