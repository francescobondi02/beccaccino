{
  "fluid": true,
  "regions": ["fra1"],
  "git": { "deploymentEnabled": false },
  "functions": {
    "api/socket-proxy.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    {
      "source": "/socket.io/",
      "has": [{ "type": "query", "key": "transport", "value": "websocket" }],
      "destination": "/api/socket-proxy"
    },
    {
      "source": "/api/:path*",
      "destination": "https://beccaccino-server.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/",
      "destination": "https://beccaccino-server.onrender.com/socket.io/"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
